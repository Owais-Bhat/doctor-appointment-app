# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Currency for fees and Stripe charges (ISO code, e.g. USD or INR)
NEXT_PUBLIC_CURRENCY=USD
# Clinic time zone for booking, "today" and reminders (IANA name)
NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata
# Signs the role cookie. Required in production, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase (database). Without these, local dev falls back to db.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (sign-in) — web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — service account (verifies sign-in tokens on the server)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Stripe (optional — payments are disabled when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video visits (optional): your own Jitsi server instead of the public meet.jit.si
NEXT_PUBLIC_JITSI_DOMAIN=

# Gemini (optional — AI assistant runs in demo mode when empty)
GEMINI_API_KEY=

# Visit reminders (24 h and 1 h before confirmed visits)
# The scheduler calls /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# sms | whatsapp | none (none = in-app reminders only)
REMINDER_CHANNEL=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender number, or a Messaging Service SID starting with MG
TWILIO_SMS_FROM=
# WhatsApp-enabled Twilio number (without the "whatsapp:" prefix)
TWILIO_WHATSAPP_FROM=
# Added to 10-digit local numbers
DEFAULT_COUNTRY_CODE=+91
