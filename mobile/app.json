{
  "expo": {
    "name": "MedFlow",
    "slug": "medflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.nestfy.medflow",
      "supportsTablet": true
    },
    "android": {
      "package": "in.nestfy.medflow",
      "adaptiveIcon": {
        "backgroundColor": "#007AFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcfcfc",
          "dark": {
            "backgroundColor": "#050505"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#007AFF",
          "defaultChannel": "default"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "MedFlow reads a photo only when you choose one, to attach a report to a visit.",
          "cameraPermission": "MedFlow uses the camera only when you take a photo of a report."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock MedFlow with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
