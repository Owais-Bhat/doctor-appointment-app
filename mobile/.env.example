# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here — these are the same public values as the web app's
# NEXT_PUBLIC_FIREBASE_* variables.

# The MedFlow web app that serves the API
EXPO_PUBLIC_API_URL=https://app.nestfy.in

# Firebase web config (Firebase console → Project settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_TIME_ZONE=Asia/Kolkata
EXPO_PUBLIC_CURRENCY=INR
